{
  "name": "petfocus",
  "version": "0.1.0",
  "description": "Desktop pet + productivity app",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vue-tsc && vite build",
    "start": "electron .",
    "start:dev": "npm run dev",
    "type-check": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "concurrently": "^9.2.1",
    "electron": "^28.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vue-tsc": "^3.2.4",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "sql.js": "^1.11.0",
    "vue": "^3.5.27"
  },
  "author": "",
  "license": "MIT"
}
